{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zapps-labs/the-software-list/main/schema.json",
  "title": "The Software List Catalog",
  "type": "object",
  "required": ["schema_version", "software"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "software": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string" },
          "repository": { "type": "string" },
          "license": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "depends": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
          "detect": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["os", "kind", "value"],
              "properties": {
                "os": { "enum": ["linux", "macos", "windows", "any"] },
                "kind": { "enum": ["binary", "path", "flatpak", "snap", "macos_app", "command"] },
                "value": { "type": "string", "minLength": 1 },
                "version_args": { "type": "array", "items": { "type": "string" } },
                "version_regex": { "type": "string" }
              }
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["os", "kind"],
              "properties": {
                "os": { "enum": ["linux", "macos", "windows", "any"] },
                "kind": {
                  "enum": [
                    "pacman", "aur", "apt", "dnf", "zypper", "apk",
                    "flatpak", "snap", "nix", "appimage",
                    "brew", "brew_cask",
                    "winget", "scoop", "choco",
                    "sh", "bash", "powershell", "cmd",
                    "download", "github_release"
                  ]
                },
                "package": { "type": "string" },
                "remote": { "type": "string" },
                "arch": { "type": "array", "items": { "type": "string" } },
                "url": { "type": "string" },
                "sha256": { "type": "string" },
                "install_cmd": { "type": "string" },
                "update_cmd": { "type": "string" },
                "uninstall_cmd": { "type": "string" },
                "priority": { "type": "integer" }
              }
            }
          },
          "configs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "paths"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "paths": {
                  "type": "object",
                  "properties": {
                    "linux": { "type": "string" },
                    "macos": { "type": "string" },
                    "windows": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
